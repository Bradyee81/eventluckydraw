{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lucky Draw",
  "version": "../package.json",
  "identifier": "com.brad.luckydraw",
  "build": {
    "beforeDevCommand": "node scripts/build-flash-tool.mjs && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node scripts/build-flash-tool.mjs && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "control",
        "title": "Lucky Draw — Control",
        "url": "index.html",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 700
      },
      {
        "label": "output",
        "title": "Lucky Draw — Output",
        "url": "index.html",
        "width": 1280,
        "height": 720,
        "resizable": true,
        "decorations": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "publisher": "Brad Yee",
    "shortDescription": "Lucky draw tool for live events",
    "licenseFile": "windows/installer-license.txt",
    "resources": {
      "resources/drivers/": "drivers/",
      "resources/templates/": "templates/",
      "resources/tools/": "tools/"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "windows/installer-hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM1MUVGNDcwODJEM0MzQjEKUldTeHc5T0NjUFFleFN2TlhuejBZNGI4eWw5c210d25qQnA1Y3puY2wxR0FTNjd3Ykd2NHpXYWoK",
      "endpoints": [
        "https://github.com/Bradyee81/eventdraw/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
